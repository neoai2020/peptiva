# ── Vite client-side variables (prefixed with VITE_) ──

# Brand identity for this deployment. Both repos (vitalabs and peptiva)
# share the same code base and the same Supabase project; the brand
# value selects which rows the frontend reads/writes and which
# tracking/config is applied at runtime.
# Allowed values: vitalabs | peptiva
VITE_BRAND=peptiva

# Supabase project connection
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Vapi (existing — voice call feature)
VITE_VAPI_API_KEY=
VITE_VAPI_ASSISTANT_ID=
VITE_VAPI_PHONE_NUMBER_ID=


# ── Supabase Edge Function secrets (set via Supabase dashboard or CLI) ──
# These are NOT exposed to the client.
#
#   supabase secrets set SHADOWPAY_SECRET_KEY=sp_test_YOUR_KEY
#   supabase secrets set SHADOWPAY_WEBHOOK_SECRET=whsec_YOUR_SECRET
#
# SHADOWPAY_SECRET_KEY        sp_test_… or sp_live_… from the KingsGate
#                             developer page (Developers → API keys).
# SHADOWPAY_WEBHOOK_SECRET    Optional. Signing secret from Developers →
#                             Webhooks. When unset the SDK fetches it with
#                             the secret key, which live keys only allow
#                             from allow-listed IPs.
# SHADOWPAY_CURRENCY          Optional, default EUR. The provider page only
#                             accepts EUR today; GBP totals are converted.
# SHADOWPAY_GBP_EUR_RATE      Optional fixed GBP→EUR rate, e.g. 1.17. When
#                             unset, today's ECB rate (frankfurter.app) is used.
# SITE_URL                    Optional fallback for the return URL when the
#                             request has no Origin header.
# ZAPIER_WEBHOOK_URL          Paid orders are sent here by shadowpay-webhook.
